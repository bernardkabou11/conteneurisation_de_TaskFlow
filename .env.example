# ============================
# Configuration API TaskFlow
# ============================

APP_ENV=production
HOST=0.0.0.0
PORT=3000

# ============================
# Base de données PostgreSQL
# ============================

DB_HOST=db
DB_PORT=5432
DB_NAME=taskflow
DB_USER=taskflow

# Mot de passe de la base
# (ne jamais mettre un vrai mot de passe ici)
DB_PASSWORD=taskflow

# Option : mot de passe via fichier (prioritaire)
# DB_PASSWORD_FILE=/run/secrets/db_password

# Tentatives de connexion
DB_CONNECT_RETRIES=5
DB_CONNECT_INTERVAL_MS=2000

# ============================
# Stress test (optionnel)
# ============================

STRESS_MAX_MS=5000

# ============================
# Timeout d'arrêt propre
# ============================

SHUTDOWN_TIMEOUT_MS=8000

# ============================
# Front-end (Vite)
# ============================

# URL de l'API pour le front
# (si ton front utilise import.meta.env.VITE_API_URL)
VITE_API_URL=http://localhost:3000
